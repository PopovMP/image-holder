- const acceptedExtensionsList = viewModel.acceptedFiles.map(function (e){return "." + e}).join(',');

doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    meta(name="robots" content="noindex, nofollow")
    title Image Holder
    link(rel="stylesheet" href="assets/css/style.css?v=" + assetVersion)
  body
    #wrapper(data-app-model=appModel)
      header.toolbar
        h1.toolbar-title Image Holder

        form#form-search.toolbar-search
          label.visually-hidden(for="input-search") Search
          input#input-search(type="search" autocomplete="off" placeholder="Search images...")

        form#form-logout
          button#button-logout.button-secondary(type="submit") Sign out

      section#import-panel
        input#data-import-input.hidden(type="file" accept=acceptedExtensionsList multiple="multiple")

        #data-import-dropzone
          p.dropzone-title Drop images here or click to upload
          p.dropzone-hint #{viewModel.acceptedFiles.join(", ")} · max #{viewModel.maxFileSizeKb} kB

        label.force-upload-line
          input#checkbox-force-upload(type="checkbox" name="force-upload")
          span Force upload (replace duplicates)

      #messages
      #image-grid

      footer.site-footer
        a(href="https://github.com/PopovMP/image-holder") https://github.com/PopovMP/image-holder

    script(src="assets/js/io-service.js?v=" + assetVersion)
    script(src="assets/js/file-dropper.js?v=" + assetVersion)
    script(src="assets/js/application-presenter.js?v=" + assetVersion)
    script(src="assets/js/application.js?v=" + assetVersion)
